# Environment Variables Template
# Copy this file to .env for local development

# Site URL (used for canonical URLs, OG tags, RSS, sitemap, and the CMS OAuth
# redirect_uri). Must exactly match the OAuth app callback registered on GitHub.
SITE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Newsroom CMS (/admin)
# ---------------------------------------------------------------------------
# Credentials for the GitHub OAuth app that lets editors sign in to /admin.
# DECAP_GITHUB_CLIENT_SECRET is a secret: it must only ever be set as a server
# environment variable, never committed and never exposed to the browser.
#
# Create the OAuth app at https://github.com/settings/developers with:
#   Homepage URL:               https://kakr.ai
#   Authorization callback URL: https://kakr.ai/api/admin/callback
# For local testing, register a second app with http://localhost:3000 instead.
#
# /admin returns a clear 503 until both values are present.
DECAP_GITHUB_CLIENT_ID=
DECAP_GITHUB_CLIENT_SECRET=

# Repository editors commit content to. Used to verify that a signing-in editor
# actually has write access before the editor UI loads.
DECAP_REPO=dev-bikash-roy/kakr-ai

# For production on Google Cloud, set:
# SITE_URL=https://kakr.ai
# NODE_ENV=production
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# DECAP_GITHUB_CLIENT_ID=<from the GitHub OAuth app>
# DECAP_GITHUB_CLIENT_SECRET=<from the GitHub OAuth app, stored as a secret>
